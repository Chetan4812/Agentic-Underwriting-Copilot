# ---------------------------------------------------------------------------
# Agentic Underwriting Copilot - Web App environment
# Copy to .env and adjust for your environment.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (matches docker-compose service `db`)
DATABASE_URL="postgresql://copilot:copilot@localhost:5432/underwriting?schema=public"

# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------
# Base URL of the existing FastAPI AI execution service (9-agent pipeline).
# When running the whole stack via docker-compose, use the service name:
#   http://ai-service:8000
AI_SERVICE_BASE_URL="http://localhost:8000"

# Optional bearer token for the AI service, if enabled server-side.
AI_SERVICE_API_KEY=""

# Timeout (ms) for AI service calls. The 9-agent pipeline can take time.
AI_SERVICE_TIMEOUT_MS="45000"

# Use the built-in deterministic MOCK AI engine instead of calling FastAPI.
# Set to "true" to run and test the whole system end-to-end WITHOUT the AI
# service. When "false", the app calls the real service and only falls back to
# the mock if the service is unreachable.
AI_SERVICE_MOCK="true"

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# Secret used to sign session JWTs. MUST be a long random string in production.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-please-32chars-min"

# Session lifetime in hours.
SESSION_TTL_HOURS="12"

# ---------------------------------------------------------------------------
# Seed credentials (used by prisma/seed.ts)
# ---------------------------------------------------------------------------
# Password applied to ALL seeded demo users (change before any real use).
SEED_DEFAULT_PASSWORD="Password123!"
# Super admin bootstrap account.
SEED_SUPERADMIN_EMAIL="superadmin@halcyoncredit.com"
SEED_SUPERADMIN_PASSWORD="SuperAdmin123!"
